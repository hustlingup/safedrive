{
  "rules": {
    "quizStats": {
      ".read": true,
      ".write": false,
      "$quizId": {
        "totalCompletions": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
        },
        "results": {
          "$resultType": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
          }
        }
      }
    },
    "plates": {
      "$plateNumber": {
        ".read": true,
        ".write": false,
        "counters": {
          "$counterKey": {
            ".write": false,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        },
        "daily": {
          "$date": {
            "$counterKey": {
              ".write": false,
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "monthly": {
          "$month": {
            "$counterKey": {
              ".write": false,
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "monthlyIncrements": {
          "$counterKey": {
            "$date": {
              ".write": false
            }
          }
        },
        "lastUpdated": {
          ".write": false,
          ".validate": "newData.isNumber()"
        },
        "views": {
          ".write": false,
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "security": {
      ".read": false,
      ".write": false,
      "nonces": {
        "$nonce": {
          ".read": false,
          ".write": false
        }
      },
      "daily": {
        "$date": {
          "$fingerprint": {
            ".read": false,
            ".write": false
          }
        }
      }
    },
    "subscriptions": {
      ".read": true,
      ".write": false,
      "$token": {
        ".read": true,
        ".write": false,
        "plates": {
          ".validate": "newData.isString() || (newData.hasChildren() && newData.val().length <= 10)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "roadStress": {
      ".read": true,
      ".write": true,
      "emotionCounts": {
        ".validate": "newData.hasChildren()"
      },
      "totalCount": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "lastResetDate": {
        ".validate": "newData.isString()"
      }
    },
    "global": {
      ".read": true,
      ".write": false,
      "allTime": {
        "$counterKey": {
          ".write": false,
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      },
      "daily": {
        "$date": {
          "$counterKey": {
            ".write": false,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "weekly": {
        "$week": {
          "$counterKey": {
            ".write": false,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "monthly": {
        "$month": {
          "$counterKey": {
            ".write": false,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "yearly": {
        "$year": {
          "$counterKey": {
            ".write": false,
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "analytics": {
      ".read": true,
      ".write": false,
      "realtime": {
        "activeUsers": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "leaderboards": {
      ".read": true,
      ".write": false,
      "allTime": {
        "$plateNumber": {
          ".write": false
        }
      },
      "daily": {
        "$date": {
          "$plateNumber": {
            ".write": false
          }
        }
      },
      "weekly": {
        "$week": {
          "$plateNumber": {
            ".write": false
          }
        }
      },
      "monthly": {
        "$month": {
          "$plateNumber": {
            ".write": false
          }
        }
      }
    },
    "plateSubscribers": {
      ".read": false,
      ".write": false,
      "$plateNumber": {
        "$token": {
          ".read": false,
          ".write": false
        }
      }
    },
    "referrals": {
      "users": {
        ".read": true,
        ".write": false,
        "$referrerId": {
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "daily": {
            "$date": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      "leaderboards": {
        ".read": true,
        ".write": false,
        "daily": {
          "$date": {
            ".indexOn": ".value",
            "$referrerId": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            }
          }
        }
      },
      "dailyWinners": {
        ".read": true,
        ".write": false,
        "$date": {
          "$referrerId": {
            "achievedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      },
      "config": {
        "adminKey": {
          ".read": true,
          ".write": false
        }
      }
    }
  }
}
