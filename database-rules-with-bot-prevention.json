{
  "rules": {
    "plates": {
      "$plateNumber": {
        ".read": true,
        ".write": false,
        "counters": {
          "$counterKey": {
            ".write": false
          }
        },
        "daily": {
          "$date": {
            "$counterKey": {
              ".write": false
            }
          }
        },
        "monthly": {
          "$month": {
            "$counterKey": {
              ".write": false
            }
          }
        },
        "lastUpdated": {
          ".write": false
        },
        "views": {
          ".write": false
        }
      }
    },
    "security": {
      ".read": false,
      ".write": false,
      "nonces": {
        "$nonce": {
          ".read": false,
          ".write": false
        }
      },
      "daily": {
        "$date": {
          "$fingerprint": {
            ".read": false,
            ".write": false
          }
        }
      }
    },
    "subscriptions": {
      "$token": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous'",
        "plates": {
          ".validate": "newData.isString() || (newData.hasChildren() && newData.val().length <= 10)"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "global": {
      ".read": true,
      ".write": false,
      "allTime": {
        "totalViews": {
          ".write": false
        },
        "totalMessages": {
          ".write": false
        }
      },
      "daily": {
        "$date": {
          "views": {
            ".write": false
          },
          "messages": {
            ".write": false
          }
        }
      },
      "weekly": {
        "$week": {
          "views": {
            ".write": false
          },
          "messages": {
            ".write": false
          }
        }
      },
      "monthly": {
        "$month": {
          "views": {
            ".write": false
          },
          "messages": {
            ".write": false
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".write": false,
      "allTime": {
        "$plateNumber": {
          ".write": false
        }
      },
      "daily": {
        "$date": {
          "$plateNumber": {
            ".write": false
          }
        }
      },
      "weekly": {
        "$week": {
          "$plateNumber": {
            ".write": false
          }
        }
      },
      "monthly": {
        "$month": {
          "$plateNumber": {
            ".write": false
          }
        }
      }
    }
  }
}
