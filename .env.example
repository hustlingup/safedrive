# Firebase Configuration
# Copy this file to .env and fill in your actual values
# Note: For client-side apps, these will be publicly visible

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Referral System Admin Key
# Set this in Firebase RTDB at /referrals/config/adminKey
REFERRAL_ADMIN_KEY=rsang1021

# HMAC Secret for Bot Prevention (Server-side only)
# Generate a new secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set in Firebase Functions via: firebase functions:config:set security.hmac_secret="your_secret_here"
# Or set as environment variable: HMAC_SECRET=your_secret_here
HMAC_SECRET=43c88404508e1ccd577c46e2f9e722340504517689e7e953d1b090ad45524fd6

# VAPID Key for Push Notifications (Client-side)
# Generate in Firebase Console: Project Settings > Cloud Messaging > Web Push certificates
# This key is used for FCM push notifications
VAPID_KEY=BBPwhFN3K4dlsDZXul31NlMdOYtyLDvSNCV_RJuyz_GIdsWd0YCd3pAM3n_M8qm9UX0ZNpSAaOPAgJZY0aTYt8c
